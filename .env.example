# Copy to .env and adjust. Everything here is optional; admin settings in the app override these.

# Host port for the web app
PORT=3102
TZ=America/Chicago
# Public address when published behind a proxy (needed for single sign-on callbacks; turns on secure cookies)
# PUBLIC_URL=https://ondoku.example.com
# APP_NAME=Ondoku

# Let anyone create an account (the first account is always allowed and becomes admin)
# REGISTRATION_ENABLED=false

# Single sign-on (OpenID Connect), e.g. Keycloak. Callback: <PUBLIC_URL>/auth/oidc/callback
# OIDC_ISSUER=https://login.example.com/realms/home
# OIDC_CLIENT_ID=ondoku
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Keycloak
# OIDC_ONLY=false
# OIDC_ADMIN_CLAIM=groups
# OIDC_ADMIN_VALUE=ondoku-admins

# Voices (Piper, medium quality). Downloaded once on first start; default = every US and British English medium voice. More can be installed (or removed) in Settings > Read aloud. Names: https://huggingface.co/rhasspy/piper-voices
# PIPER_VOICES=en_US-lessac-medium,en_US-ryan-medium,en_GB-cori-medium
# TTS_DEFAULT_VOICE=en_US-lessac-medium
# TTS_MAX_CONCURRENT=2
# TTS_MAX_LOADED_VOICES=4
# AUDIO_CACHE_MB=2048

# Saved article pictures (kept in data/images so articles keep them if the site removes them)
# SAVE_IMAGES=true
# MAX_IMAGE_MB=8
# MAX_IMAGES_PER_ARTICLE=60
# MAX_ARTICLE_IMAGES_MB=60

# Fetching pages
# Allow saving links to LAN / localhost addresses (blocked by default to protect your network)
# ALLOW_PRIVATE_URLS=false
# FETCH_TIMEOUT_SECONDS=25
# MAX_PAGE_MB=8
# FETCH_CONCURRENCY=3

# Browser apps calling the API with an API key from another origin
# CORS_ORIGINS=https://kairos.example.com
